<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:h="jakarta.faces.html"
      xmlns:f="jakarta.faces.core"
      xmlns:p="primefaces"
      xmlns:ui="jakarta.faces.facelets">

<ui:composition template="/template.xhtml">
    <ui:define name="pageTitle">Attendance Management</ui:define>
    <ui:define name="content">

        <h:form id="attMgmtForm">
            <p:growl id="growl" life="4000" showDetail="false" />
            <div class="section-card" style="margin-bottom:20px;">
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
                    <h3 style="margin:0;"><span class="pi pi-clock" style="margin-right:8px;" />Attendance Management</h3>
                    <div style="display:flex; gap:10px; align-items:center; flex-wrap:nowrap;">
						<p:datePicker value="#{attendanceManagementBean.selectedDate}" pattern="dd/MM/yyyy" styleClass="form-control"
						 showIcon="true" style="width:160px;" />
						<p:commandButton value="View" icon="pi pi-search" styleClass="p-button-sm" style="white-space:nowrap;"
						action="#{attendanceManagementBean.loadDailyAttendance}" update="attMgmtForm" process="@this attMgmtForm" />
						<p:commandButton value="Mark Attendance" icon="pi pi-plus" styleClass="p-button-sm" style="white-space:nowrap;"
						action="#{attendanceManagementBean.openMarkDialog}" update="markDialog" process="@this" oncomplete="PF('markDialogWidget').show()" />
                    </div>
                </div>
            </div>

            <!-- ── Daily attendance table ── -->
            <div class="section-card">
                <p:dataTable value="#{attendanceManagementBean.dailyAttendance}"
                             var="att"
                             emptyMessage="No attendance records found for this date"
                             stripedRows="true"
                             styleClass="hrms-table"
                             paginator="true"
                             rows="10"
							 paginatorPosition="bottom"
                             paginatorTemplate="{FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}">

                    <p:column headerText="Employee">
                        <h:outputText value="#{att.employeeName}" />
                        <br />
                        <small style="color:#888;">#{att.employeeCode}</small>
                    </p:column>
					<p:column headerText="Check In">
					    <h:outputText value="#{att.checkInTime}" rendered="#{att.checkInTime != null}">
					        <f:convertDateTime pattern="hh:mm a" type="localDateTime" />
					    </h:outputText>
					    <h:outputText value="—" rendered="#{att.checkInTime == null}" />
					</p:column>

					<p:column headerText="Check Out">
					    <h:outputText value="#{att.checkOutTime}" rendered="#{att.checkOutTime != null}">
					        <f:convertDateTime pattern="hh:mm a" type="localDateTime" />
					    </h:outputText>
					    <h:outputText value="—" rendered="#{att.checkOutTime == null}" />
					</p:column>
                    <p:column headerText="Working Hours">
                        <h:outputText value="#{att.workingHours != null ? att.workingHours : '—'}" />
                    </p:column>
                    <p:column headerText="Status" style="width:120px">
                        <span class="emp-badge #{att.status == 'PRESENT' ? 'badge-active' : (att.status == 'ABSENT' ? 'badge-terminated' : (att.status == 'ON_LEAVE' ? 'badge-on-leave' : 'badge-inactive'))}">
                            #{att.status}
                        </span>
                    </p:column>
                    <p:column headerText="Marked By" style="width:110px">
                        <h:outputText value="#{att.markedByHr ? 'HR' : 'Self'}" />
                    </p:column>

                </p:dataTable>
            </div>

            <!-- ── Manual Marking Dialog ── -->
            <p:dialog id="markDialog"
                      header="Mark Attendance"
                      widgetVar="markDialogWidget"
                      modal="true"
                      resizable="false"
                      width="460"
                      styleClass="hrms-dialog">

                <div class="dialog-body">

                    <div class="form-field" style="margin-bottom:16px;">
                        <label>Employee <span class="required">*</span></label>
                        <p:selectOneMenu value="#{attendanceManagementBean.markEmployeeId}" styleClass="form-control">
                            <f:selectItem itemValue="#{null}" itemLabel="-- Select Employee --" noSelectionOption="true" />
                            <f:selectItems value="#{attendanceManagementBean.employees}" var="emp"
                                           itemValue="#{emp.id}"
                                           itemLabel="#{emp.firstName} #{emp.lastName} (#{emp.employeeCode})" />
                        </p:selectOneMenu>
                    </div>

                    <div class="form-field" style="margin-bottom:16px;">
                        <label>Date <span class="required">*</span></label>
                        <p:datePicker value="#{attendanceManagementBean.markDate}"
                                      pattern="dd/MM/yyyy"
                                      styleClass="form-control"
                                      showIcon="true"
									  style="width:100%;" />
                    </div>

                    <div class="form-field" style="margin-bottom:20px;">
                        <label>Status <span class="required">*</span></label>
                        <p:selectOneMenu value="#{attendanceManagementBean.markStatus}" styleClass="form-control">
                            <f:selectItem itemValue="#{null}" itemLabel="-- Select Status --" noSelectionOption="true" />
                            <f:selectItem itemValue="PRESENT" itemLabel="Present" />
                            <f:selectItem itemValue="ABSENT" itemLabel="Absent" />
                            <f:selectItem itemValue="HALF_DAY" itemLabel="Half Day" />
                            <f:selectItem itemValue="ON_LEAVE" itemLabel="On Leave" />
                        </p:selectOneMenu>
                    </div>

                   <div style="display:flex; gap:10px; justify-content:center;">
                        <p:commandButton value="Save"
                                         icon="pi pi-check"
                                         styleClass="p-button-sm"
                                         action="#{attendanceManagementBean.markAttendance}"
                                         update="attMgmtForm"
                                         process="markDialog"
                                         oncomplete="if(!args.validationFailed) PF('markDialogWidget').hide()" />
                        <p:commandButton value="Cancel"
                                         icon="pi pi-times"
                                         styleClass="p-button-sm p-button-outlined"
                                         onclick="PF('markDialogWidget').hide()"
                                         type="button" />
                    </div>

                </div>

            </p:dialog>

        </h:form>

    </ui:define>

</ui:composition>
</html>