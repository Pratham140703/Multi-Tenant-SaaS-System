/* ── Reset & base ─────────────────────────────────────── */
* { box-sizing: border-box; margin: 0; padding: 0; }

body.hrms-body {
    display: flex;
    font-family: 'Segoe UI', sans-serif;
    background: #f4f6fb;
    min-height: 100vh;
    color: #334155;
}

/* ── Sidebar ──────────────────────────────────────────── */
.hrms-sidebar {
    width: 230px;
    min-height: 100vh;
    background: #1e293b;
    color: #cbd5e1;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    position: fixed;
    top: 0; left: 0; bottom: 0;
    z-index: 100;
}

.sidebar-logo {
    padding: 24px 20px 20px;
    font-size: 1.3rem;
    font-weight: 700;
    color: #f1f5f9;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid #334155;
}

.logo-icon { font-size: 1.5rem; color: #6366f1; }

.sidebar-nav {
    list-style: none;
    padding: 16px 0;
    flex: 1;
}

.nav-item { margin: 2px 10px; border-radius: 8px; }

.nav-item.active { background: #6366f1; }

.nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    color: #cbd5e1;
    text-decoration: none;
    border-radius: 8px;
    font-size: 0.9rem;
    transition: background 0.15s;
}

.nav-item.active .nav-link { color: #fff; }

.nav-link:hover { background: #334155; color: #f1f5f9; }

.nav-icon { font-size: 1rem; width: 18px; }

/* ── Main ─────────────────────────────────────────────── */
.hrms-main {
    margin-left: 230px;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* ── Topbar ───────────────────────────────────────────── */
.hrms-topbar {
    height: 60px;
    background: #fff;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    position: sticky;
    top: 0;
    z-index: 50;
}

.page-title { font-size: 1.15rem; font-weight: 600; color: #1e293b; }

.topbar-right {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 0.9rem;
}

.topbar-icon { font-size: 1.1rem; cursor: pointer; color: #64748b; }

.topbar-user {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #334155;
    font-weight: 500;
}

.logout-btn {
    background: transparent !important;
    border: 1px solid #e2e8f0 !important;
    color: #64748b !important;
    font-size: 0.82rem !important;
    padding: 5px 12px !important;
    border-radius: 6px !important;
}

.logout-btn:hover { background: #f1f5f9 !important; }

/* ── Content ──────────────────────────────────────────── */
.hrms-content {
    padding: 28px;
    flex: 1;
}

/* ── Stat cards ───────────────────────────────────────── */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 28px;
}

.stat-card {
    background: #fff;
    border-radius: 12px;
    padding: 22px 24px;
    display: flex;
    align-items: center;
    gap: 18px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    border-left: 4px solid transparent;
}

.stat-card.blue   { border-left-color: #6366f1; }
.stat-card.green  { border-left-color: #22c55e; }
.stat-card.orange { border-left-color: #f97316; }
.stat-card.purple { border-left-color: #a855f7; }
.stat-card.teal   { border-left-color: #14b8a6; }

.stat-icon-wrap {
    width: 48px; height: 48px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
}

.stat-card.blue   .stat-icon-wrap { background: #eef2ff; color: #6366f1; }
.stat-card.green  .stat-icon-wrap { background: #f0fdf4; color: #22c55e; }
.stat-card.orange .stat-icon-wrap { background: #fff7ed; color: #f97316; }
.stat-card.purple .stat-icon-wrap { background: #faf5ff; color: #a855f7; }
.stat-card.teal   .stat-icon-wrap { background: #f0fdfa; color: #14b8a6; }

.stat-info { display: flex; flex-direction: column; gap: 4px; }
.stat-value { font-size: 1.6rem; font-weight: 700; color: #1e293b; }
.stat-label { font-size: 0.8rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; }

/* ── Section card ─────────────────────────────────────── */
.section-card {
    background: #fff;
    border-radius: 12px;
    padding: 22px 24px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    margin-bottom: 20px;
}

.section-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
}

/* ── Payroll filter bar ───────────────────────────────── */
.filter-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.filter-bar label { font-size: 0.85rem; color: #64748b; font-weight: 500; }

/* ── Misc ─────────────────────────────────────────────── */
.badge-pending {
    background: #fff7ed;
    color: #f97316;
    border-radius: 20px;
    padding: 2px 10px;
    font-size: 0.78rem;
    font-weight: 600;
}	
	
/* ── Employee status badges ───────────────────────────── */
.emp-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.badge-active     { background: #f0fdf4; color: #16a34a; }
.badge-inactive   { background: #f1f5f9; color: #64748b; }
.badge-on-leave   { background: #fefce8; color: #ca8a04; }
.badge-terminated { background: #fef2f2; color: #dc2626; }

/* ── Form grid ────────────────────────────────────────── */
.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 24px;
}

.form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-field-full {
    grid-column: 1 / -1;
}

.form-field label {
    font-size: 0.85rem;
    font-weight: 500;
    color: #374151;
}

.required { color: #ef4444; }

.form-control {
    width: 100% !important;
}

/* ── Table tweaks ─────────────────────────────────────── */
.hrms-table .ui-datatable-thead th {
    background: #f8fafc !important;
    color: #374151 !important;
    font-size: 0.82rem !important;
    font-weight: 600 !important;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.hrms-table .ui-datatable-tbody td {
    font-size: 0.88rem;
    color: #334155;
    vertical-align: middle;
}

/* ── Dialog ───────────────────────────────────────────── */
.hrms-dialog .p-dialog-header {
    background: #1e293b !important;
    color: #f1f5f9 !important;
    border-radius: 12px 12px 0 0 !important;
    padding: 16px 20px !important;
    font-size: 1rem !important;
    font-weight: 600 !important;
}

.hrms-dialog .p-dialog-content {
    padding: 0 !important;
    border-radius: 0 0 12px 12px !important;
}

.dialog-body {
    padding: 22px 24px;
}

.form-field textarea.form-control {
    width: 100% !important;
    resize: none;
    font-family: 'Segoe UI', sans-serif;
    font-size: 0.88rem;
}
.page-header {
    margin-bottom: 1.5rem;
}
/* Fix datepicker width in header bar */
.p-d.p-datepicker-input {
    width: 100% !important;
}
/* Date picker full width fix */
.hrms-dialog .p-datepicker {
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
}

.hrms-dialog .p-datepicker input {
    flex: 1 !important;
    width: auto !important;
    min-width: 0 !important;
}

.hrms-dialog .p-inputwrapper {
    width: 100% !important;
}

.hrms-dialog input[type="text"] {
    width: 100% !important;
}

.hrms-dialog .ui-inputnumber {
    width: 100% !important;
}

.hrms-dialog .ui-inputnumber-input {
    width: 100% !important;
}

/* ── Dialog ───────────────────────────────────────────── */
.hrms-dialog .p-dialog-header {
    background: #1e293b !important;
    color: #f1f5f9 !important;
    border-radius: 12px 12px 0 0 !important;
    padding: 16px 20px !important;
    font-size: 1rem !important;
    font-weight: 600 !important;
}

.hrms-dialog .p-dialog-content {
    padding: 0 !important;
    border-radius: 0 0 12px 12px !important;
}

.dialog-body {
    padding: 22px 24px;
    width: 100%;
    box-sizing: border-box;
}

/* Button row inside dialogs */
.dialog-actions {
    display: flex;
    width: 100%;
    gap: 10px;
    justify-content: flex-end;
    margin-top: 4px;
}


